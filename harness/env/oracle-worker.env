# worker lane: oracle-relay.env(Relay 켬, 정리 작업·런타임 로그 끔)에 푸시 Worker를 더한 lane의 환경변수.
# lane.sh up ... (WORKER=1)이 compose의 LANE_ENV_EXTRA로 넘긴다. Relay가 큐에 넣은 메시지를 Worker가 같은 가짜 SQS에서 받아
# 처리하고 지우는 것까지 한 lane에서 본다.
#
# 원본의 FCM 주소(https://fcm.googleapis.com)는 설정으로 바꿀 수 없다. 그래서 Java는 FCM을 부르는 경로(기기 있고 발송 조건이
# 맞는 메시지)를 이 lane에서 확인할 수 없고, 시나리오는 FCM을 부르지 않고 끝나는 경로만 둔다. Rust는 같은 lane에서
# NOTIFICATION_FCM_ENDPOINT_URL로 가짜 FCM(fakes)을 쓸 수 있다(원본에 없는 설정이라 Java는 읽지 않는다).
# OAuth 토큰 주소는 서비스 계정 파일의 token_uri(harness/keys/fcm-service-account.json)라 양쪽이 같은 가짜 서버를 본다.
CHALKAK_SCHEDULING_ENABLED=true
CHALKAK_AUTH_REFRESHTOKEN_CLEANUP_ENABLED=false
CHALKAK_AUTH_CONSUMEDSIGNUPTOKEN_CLEANUP_ENABLED=false
CHALKAK_AUTH_PENDINGAPPLEAUTHORIZATION_CLEANUP_ENABLED=false
CHALKAK_NOTIFICATION_CLEANUP_ENABLED=false
CHALKAK_MONITORING_RUNTIMELOG_ENABLED=false
NOTIFICATION_RELAY_ENABLED=true
NOTIFICATION_TOPIC_PUSH_ENABLED=false
NOTIFICATION_SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/000000000000/chalkak-test-push
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_FCM_PROJECT_ID=chalkak-harness
NOTIFICATION_FCM_CREDENTIALS_PATH=/secrets/fcm-service-account.json
NOTIFICATION_FCM_ENDPOINT_URL=http://fakes:9000
