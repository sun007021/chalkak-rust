# Java oracle(기준 서버) 공통 환경변수. 값은 원본 src/test/resources/application-test.yml의 테스트 값을 따른다.
# 실제 비밀값이 아니다. 하네스의 Rust 대상도 같은 값을 쓴다. docker compose env_file로 읽으며, $가 든 값은 작은따옴표로 감싸 치환을 막는다.
SPRING_PROFILES_ACTIVE=local
ACCESS_TOKEN_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
ACCESS_TOKEN_EXPIRATION=15m
SOCIAL_SIGNUP_TOKEN_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SOCIAL_IDENTITY_HMAC_SECRET=aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899
REFRESH_TOKEN_INACTIVITY_EXPIRATION=30d
REFRESH_TOKEN_ABSOLUTE_EXPIRATION=90d
GOOGLE_OIDC_CLIENT_ID=test-google-client-id
KAKAO_OIDC_APP_KEY=test-kakao-app-key
APPLE_OIDC_CLIENT_ID=test-apple-client-id
APPLE_TEAM_ID=test-team-id
APPLE_KEY_ID=test-key-id
APPLE_PRIVATE_KEY_
APPLE_REFRESH_TOKEN_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# 관리자 인증은 실제 로그인 경로로 검증한다. 비밀번호 "operator-password"의 BCrypt(cost 12) 해시.
ADMIN_DEVELOPMENT_BYPASS_ENABLED=false
ADMIN_USERNAME=operator
ADMIN_PASSWORD_HASH='$2y$12$GbP5jGCW/tL2TyqY9POOG.gHRFksjWnUfK/OtpzXE.U5.tyR1.MX6'
ADMIN_NOTIFICATION_DELIVERY_ENABLED=false
ADMIN_WEB_BASE_URL=https://admin.test.chalkak
S3_BUCKET=test-bucket
AWS_REGION=ap-northeast-2
S3_PREFIX=chalkak
CLOUDFRONT_BASE_URL=https://cdn.test.chalkak
CLOUDFRONT_ORIGIN_PATH=/chalkak
AWS_ACCESS_KEY_ID=AKIAHARNESSTEST00000
AWS_SECRET_ACCESS_KEY=harness/secret/key/for/deterministic/presign
IMAGE_PROCESSOR_CALLBACK_SECRET=test-callback-secret-with-enough-length
POST_IMAGE_PROCESSING_TIMEOUT=7m
SIGNATURE_PROCESSING_TIMEOUT=7m
CALLBACK_MAX_BODY_BYTES=65536
LOGGING_LEVEL_ORG_HIBERNATE_SQL=info
TZ=UTC
# 외부 연동은 가짜 서버(compose의 fakes 서비스, harness/fakes)로 돌린다. 발급자(issuer)는 실제 값을 그대로 두고
# 공개키 주소·토큰 서버 주소·S3 엔드포인트만 바꾼다. Spring은 chalkak.auth.* 속성을 환경변수로 덮어쓸 수 있다.
# Rust 서버도 같은 값을 읽어 가짜 서버를 본다.
CHALKAK_AUTH_OIDC_GOOGLE_JWKSETURI=http://fakes:9000/oidc/google/certs
CHALKAK_AUTH_OIDC_KAKAO_JWKSETURI=http://fakes:9000/oidc/kakao/jwks.json
CHALKAK_AUTH_OIDC_APPLE_JWKSETURI=http://fakes:9000/oidc/apple/keys
CHALKAK_AUTH_APPLE_TOKEN_TOKENURI=http://fakes:9000/apple/auth/token
CHALKAK_AUTH_APPLE_TOKEN_REVOKEURI=http://fakes:9000/apple/auth/revoke
# AWS SDK 공통 환경변수. S3 요청만 가짜 서버로 보낸다(SDK는 <버킷>.fakes 가상 호스트 주소를 쓰고, compose가 별칭을 준다).
AWS_ENDPOINT_URL_S3=http://fakes:9000
# SQS도 같은 가짜 서버로 보낸다(JSON 프로토콜, X-Amz-Target 헤더로 구분). 큐 URL은 요청 본문에만 들어가고 주소는 이 값이 정한다.
# SQS를 쓰는 작업(Relay, 주제 푸시)은 기본 lane에서 꺼져 있고 relay lane(oracle-relay.env)에서만 켠다.
AWS_ENDPOINT_URL_SQS=http://fakes:9000
# local 프로필은 익명 자격증명을 쓰는데(application-local.yml) 익명으로는 presigned URL을 만들 수 없다(SigV4 필요).
# 위의 정적 자격증명(AWS_ACCESS_KEY_ID/SECRET)으로 서명하도록 끈다. 하네스는 서명이 결정적이도록 이 값을 고정한다.
CHALKAK_IMAGE_ANONYMOUSACCESS=false
# 주기 작업은 끈다. 시나리오가 faketime으로 시계를 며칠씩 옮기는데, Spring 스케줄러는 기동 때 계산한 지연을 단조 시계로
# 기다려 옮긴 시계를 따라가지 않는다(Java는 정리하지 않는다). 시계를 따라가는 Rust 스케줄러가 정리하면 DB 상태가 달라진다.
# 원본 test 프로필도 같은 이유로 chalkak.scheduling.enabled=false다. 정리 쿼리와 cron 판정은 cargo 시험이 확인한다.
CHALKAK_SCHEDULING_ENABLED=false
# 사용자 지표 집계(#41). 접근 로그 지표는 CloudWatch Logs 대신 가짜 서버가 답한다(AWS SDK 서비스별 엔드포인트).
# 로그 그룹은 원본 test 프로필 시험과 같은 이름이고, 제외 회원 하나로 회원 기준 쿼리의 제외 조건을 확인한다.
AWS_ENDPOINT_URL_CLOUDWATCH_LOGS=http://fakes:9000
CHALKAK_ANALYTICS_LOGGROUP=/chalkak/test/application
CHALKAK_ANALYTICS_EXCLUDEDUSERIDS=01990000-0000-7000-8000-0000000000e1
