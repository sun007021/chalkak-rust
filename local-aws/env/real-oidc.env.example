# 실계정 모드 오버레이: 앱에서 실제 Google·Kakao·Apple 로그인을 쓰려고 백엔드가 진짜 공개키(JWKS)와 앱과 같은 클라이언트 값을 쓰게 한다.
# 사용: cp env/real-oidc.env.example env/real-oidc.env  (git 에 올라가지 않는다) -> 아래 <...> 를 채운다 ->
#   docker compose -f compose.yaml -f compose.real-oidc.yaml --profile rust up -d     # 또는 --profile java
# 되돌리기(가짜 모드): -f compose.real-oidc.yaml 없이 같은 명령으로 다시 up -d. 자세한 설명은 docs/local-aws/app.md.
#
# 이 파일은 env/local-aws.env 뒤에 읽혀서 같은 키를 덮어쓴다(compose.real-oidc.yaml 의 env_file 순서).
# 필요한 값은 앱 빌드가 쓰는 값과 짝이다. 비밀 값은 이 파일에 쓰고 커밋하지 않는다.

# ---- 앱과 같아야 하는 값(ID Token 의 aud 와 비교한다) -------------------------------------------
# Google: 앱의 GOOGLE_SERVER_CLIENT_ID 와 같은 웹 클라이언트 ID.
#   Android local.properties GOOGLE_SERVER_CLIENT_ID, iOS xcconfig GOOGLE_SERVER_CLIENT_ID (둘 다 서버용 ID 로 토큰을 받는다).
GOOGLE_OIDC_CLIENT_ID=<앱의 GOOGLE_SERVER_CLIENT_ID>
# Kakao: 앱의 KAKAO_NATIVE_APP_KEY (Android·iOS Kakao SDK 가 공통으로 쓰는 네이티브 앱 키. 원본 infrastructure-setup.md:139).
KAKAO_OIDC_APP_KEY=<앱의 KAKAO_NATIVE_APP_KEY>
# Apple: iOS 앱 번들 ID (원본 클라이언트 project.pbxproj 의 PRODUCT_BUNDLE_IDENTIFIER = com.stonefive.chalkak).
APPLE_OIDC_CLIENT_ID=com.stonefive.chalkak
# Apple 가입·탈퇴(토큰 교환·철회)는 팀 키가 필요하다. 팀 키가 없으면 아래 세 줄을 그대로 주석으로 두고(local-aws.env 의 더미 키를 쓴다)
# Apple 은 기존 회원 로그인만 시험하거나 제외한다. 더미 키로는 Apple 서버가 가입의 토큰 교환을 거절한다(로그인은 JWKS 검증만이라 동작).
#APPLE_TEAM_ID=<Apple 팀 ID>
#APPLE_KEY_ID=<Sign in with Apple 키 ID>
#APPLE_PRIVATE_KEY_BASE64=<.p8 파일을 base64 한 한 줄: base64 -w0 AuthKey_XXXX.p8>

# ---- 진짜 공개키·토큰 서버(가짜 fakes 대신) ----------------------------------------------------
# 값은 원본 application.yml 의 기본값과 같다. 가짜 모드에서는 local-aws.env 가 fakes 주소로 덮었던 키다.
CHALKAK_AUTH_OIDC_GOOGLE_JWKSETURI=https://www.googleapis.com/oauth2/v3/certs
CHALKAK_AUTH_OIDC_KAKAO_JWKSETURI=https://kauth.kakao.com/.well-known/jwks.json
CHALKAK_AUTH_OIDC_APPLE_JWKSETURI=https://appleid.apple.com/auth/keys
CHALKAK_AUTH_APPLE_TOKEN_TOKENURI=https://appleid.apple.com/auth/token
CHALKAK_AUTH_APPLE_TOKEN_REVOKEURI=https://appleid.apple.com/auth/revoke
