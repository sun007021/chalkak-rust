# 로컬 AWS 재현 환경의 백엔드 환경변수. 키 이름은 원본 backend/deploy/examples/application.dev.env.example 그대로다
# (Rust·Java 공통, SPRING_PROFILES_ACTIVE=dev 계약: Lambda 가 처리하는 staging 환경은 dev·prod 뿐이다).
# 값은 모두 로컬 시험용 더미다. 실제 비밀이 아니다. ${HOST_IP:-127.0.0.1} 는 compose 가 채운다.
# $ 가 든 값은 compose 치환을 막으려고 작은따옴표로 감쌌다.
#
# "[로컬 전용]" 표시가 붙은 블록만 실제 AWS(#32 배포)에서는 뺀다. 나머지는 그대로 쓸 수 있다.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
TZ=Asia/Seoul

# 소셜 로그인. 값은 harness/parity 가 서명하는 가짜 ID Token 의 aud 와 같다(harness/env/oracle.env).
GOOGLE_OIDC_CLIENT_ID=test-google-client-id
KAKAO_OIDC_APP_KEY=test-kakao-app-key
APPLE_OIDC_CLIENT_ID=test-apple-client-id
APPLE_TEAM_ID=test-team-id
APPLE_KEY_ID=test-key-id
APPLE_PRIVATE_KEY_
APPLE_REFRESH_TOKEN_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
SOCIAL_SIGNUP_TOKEN_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACCESS_TOKEN_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
SOCIAL_IDENTITY_HMAC_SECRET=aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_INACTIVITY_EXPIRATION=30d
REFRESH_TOKEN_ABSOLUTE_EXPIRATION=90d

# 관리자. 비밀번호는 "operator-password" (BCrypt cost 12).
ADMIN_USERNAME=operator
ADMIN_PASSWORD_HASH='$2y$12$GbP5jGCW/tL2TyqY9POOG.gHRFksjWnUfK/OtpzXE.U5.tyR1.MX6'
ADMIN_CORS_ALLOWED_ORIGIN=https://admin.${HOST_IP:-127.0.0.1}.sslip.io
ADMIN_NOTIFICATION_DELIVERY_ENABLED=false
ADMIN_SLACK_WEBHOOK_URL=http://fakes:9000/slack/services/T000/B000/local
ADMIN_WEB_BASE_URL=https://admin.${HOST_IP:-127.0.0.1}.sslip.io

DB_HOST=postgres
DB_PORT=5432
DB_NAME=chalkak
DB_USERNAME=chalkak
DB_PASSWORD=local-aws-password

# 이미지. 버킷·prefix·콜백 비밀은 원본 dev 와 같은 이름 계약이다.
AWS_REGION=ap-northeast-2
S3_BUCKET=techcourse-project-2026
S3_PREFIX=chalkak
CLOUDFRONT_BASE_URL=https://cdn.${HOST_IP:-127.0.0.1}.sslip.io
CLOUDFRONT_ORIGIN_PATH=/chalkak
IMAGE_PROCESSOR_CALLBACK_SECRET=local-aws-callback-secret-with-enough-length
POST_IMAGE_PROCESSING_TIMEOUT=7m
SIGNATURE_PROCESSING_TIMEOUT=7m
CALLBACK_MAX_BODY_BYTES=65536

# 알림(푸시)은 L0 이후(L4)에 켠다. 큐 URL 은 amazonaws 형식을 유지하고 전송은 AWS_ENDPOINT_URL_SQS 로 돌린다.
NOTIFICATION_RELAY_ENABLED=false
NOTIFICATION_TOPIC_PUSH_ENABLED=false
NOTIFICATION_NOTICE_DISTRIBUTION_ENABLED=false
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_FCM_PROJECT_ID=local-aws
NOTIFICATION_FCM_CREDENTIALS_PATH=/dev/null
NOTIFICATION_SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/000000000000/chalkak-dev-push

# ---- [로컬 전용] 엔드포인트 재정의 ---------------------------------------------------------------
# 자격증명: AWS_ACCESS_KEY_ID 를 두지 않는다. 백엔드는 EC2 인스턴스 역할처럼 IMDSv2(imds-mock)에서 받는다.
AWS_EC2_METADATA_SERVICE_ENDPOINT=http://imds-mock:1338
# S3: 서버가 서명하는 주소가 곧 앱이 PUT 하는 주소다. 가상 호스트 <버킷>.s3.<IP>.sslip.io 로 간다(edge 가 TLS 종료).
AWS_ENDPOINT_URL_S3=https://s3.${HOST_IP:-127.0.0.1}.sslip.io
AWS_ENDPOINT_URL_SQS=http://aws:4566
# 로컬 CA(edge 의 Caddy internal CA 루트). Rust 는 SSL_CERT_FILE 로, Java 는 compose 의 시작 스크립트가 truststore 에 넣는다.
SSL_CERT_FILE=/ca/root.crt
# OIDC 공개키·Apple 토큰 서버는 가짜 서버(harness/fakes)로 돌린다. 발급자는 실제 값 그대로다.
CHALKAK_AUTH_OIDC_GOOGLE_JWKSETURI=http://fakes:9000/oidc/google/certs
CHALKAK_AUTH_OIDC_KAKAO_JWKSETURI=http://fakes:9000/oidc/kakao/jwks.json
CHALKAK_AUTH_OIDC_APPLE_JWKSETURI=http://fakes:9000/oidc/apple/keys
CHALKAK_AUTH_APPLE_TOKEN_TOKENURI=http://fakes:9000/apple/auth/token
CHALKAK_AUTH_APPLE_TOKEN_REVOKEURI=http://fakes:9000/apple/auth/revoke
